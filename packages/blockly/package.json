{
  "name": "blockly",
  "version": "13.2.1",
  "description": "Blockly is a library for building visual programming editors.",
  "keywords": [
    "blockly"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaspberryPiFoundation/blockly.git"
  },
  "bugs": {
    "url": "https://github.com/RaspberryPiFoundation/blockly/issues"
  },
  "homepage": "https://blockly.com",
  "author": {
    "name": "Neil Fraser"
  },
  "browser": {
    "jsdom": false
  },
  "imports": {
    "#core/*": "./build/src/core/*",
    "#generators/*": "./build/src/generators/*"
  },
  "publishConfig": {
    "directory": "dist"
  },
  "nx": {
    "implicitDependencies": ["!@blockly/block-test"],
    "targets": {
      "build": {
        "dependsOn": ["package", "^build"]
      },
      "test": {
        "dependsOn": [
          {
            "projects": "@blockly/block-test",
            "target": "build"
          },
          {
            "projects": "@blockly/dev-tools",
            "target": "build"
          }
        ] 
      },
      "docs": {
        "dependsOn": ["package", "^build"]
      }
    }
  },
  "scripts": {
    "build": "gulp build",
    "build-debug": "gulp build --verbose --debug",
    "build-debug-log": "npm run build:debug > build-debug.log 2>&1 && tail -3 build-debug.log",
    "build-strict": "gulp build --verbose --strict",
    "build-strict-log": "npm run build:strict > build-debug.log 2>&1 && tail -3 build-debug.log",
    "clean": "gulp clean",
    "deployDemos": "npm ci && gulp deployDemos",
    "deployDemos:beta": "npm ci && gulp deployDemosBeta",
    "docs": "gulp docs",
    "messages": "gulp messages",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "langfiles": "gulp langfiles",
    "minify": "gulp minify",
    "package": "gulp pack",
    "prepareDemos": "gulp prepareDemos",
    "start": "npm run build && concurrently -n tsc,server \"tsc --watch --preserveWatchOutput --outDir \"build/src\" --declarationDir \"build/declarations\"\" \"http-server ./ -s -o /tests/playground.html -c-1\"",
    "start:advanced": "npm run package && npx nx run @blockly/dev-tools:build && concurrently  -n server,watch \"npx nx run @blockly/dev-tools:start\" \"npx nx watch --projects=@blockly/dev-tools --includeDependencies -- npm run build\"",
    "tsc": "gulp tsc",
    "test": "gulp test",
    "test:browser": "npx mocha --config tests/browser/.mocharc.js",
    "test:mocha:node": "npx mocha --config tests/mocha/.mocharc.node.cjs \"tests/mocha/**/*_test.js\"",
    "test:generators": "gulp testGenerators",
    "test:mocha:interactive": "npm run build && concurrently -n tsc,server \"tsc --watch --preserveWatchOutput --outDir \"build/src\" --declarationDir \"build/declarations\"\" \"gulp interactiveMocha\"",
    "test:compile:advanced": "gulp buildAdvancedCompilationTest --debug",
    "updateGithubPages": "npm ci && node scripts/update_github_pages.mjs --upstream",
    "updateGithubPages:staging": "npm ci && node scripts/update_github_pages.mjs --use-local"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "umd": "./dist/blockly.min.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "node": "./dist/core-node.js",
      "import": "./dist/blockly.mjs",
      "default": "./dist/blockly_compressed.js"
    },
    "./blocks": {
      "types": "./dist/blocks.d.ts",
      "import": "./dist/blocks.mjs",
      "default": "./dist/blocks_compressed.js"
    },
    "./dart": {
      "types": "./dist/dart.d.ts",
      "import": "./dist/dart.mjs",
      "default": "./dist/dart_compressed.js"
    },
    "./lua": {
      "types": "./dist/lua.d.ts",
      "import": "./dist/lua.mjs",
      "default": "./dist/lua_compressed.js"
    },
    "./javascript": {
      "types": "./dist/javascript.d.ts",
      "import": "./dist/javascript.mjs",
      "default": "./dist/javascript_compressed.js"
    },
    "./php": {
      "types": "./dist/php.d.ts",
      "import": "./dist/php.mjs",
      "default": "./dist/php_compressed.js"
    },
    "./python": {
      "types": "./dist/python.d.ts",
      "import": "./dist/python.mjs",
      "default": "./dist/python_compressed.js"
    },
    "./msg/*": {
      "types": "./dist/msg/*.d.ts",
      "import": "./dist/msg/*.mjs",
      "default": "./dist/msg/*.js"
    }
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@blockly/block-test": "^13.1.0",
    "@hyperjump/browser": "^1.3.1",
    "@hyperjump/json-schema": "^1.17.6",
    "@microsoft/api-documenter": "7.30.7",
    "@microsoft/api-extractor": "^7.58.9",
    "async-done": "^2.0.0",
    "chai": "^6.2.2",
    "concurrently": "^10.0.4",
    "glob": "^13.0.6",
    "google-closure-compiler": "^20260803.0.0",
    "gulp": "^5.0.1",
    "gulp-concat": "^2.6.1",
    "gulp-gzip": "^1.4.2",
    "gulp-rename": "^2.1.0",
    "gulp-replace": "^1.1.4",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-umd": "^2.0.0",
    "http-server": "^14.1.1",
    "jsdom": "30.0.1",
    "json5": "^2.2.3",
    "mocha": "^11.7.6",
    "puppeteer-core": "^25.3.0",
    "rimraf": "^6.1.3",
    "sinon": "^22.1.0",
    "typescript": "^6.0.3",
    "webdriverio": "^9.30.0",
    "yargs": "^18.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "jsdom": ">=27.4.0 <30.0.0"
  }
}
